# =============================================
# Переменные окружения CRM «Атланта»
# Скопируйте этот файл в server/.env и укажите ваши параметры
# =============================================

# Подключение к PostgreSQL
DATABASE_URL=postgresql://atlanta_user:atlanta_pass@localhost:5432/atlanta_crm

# Секретный ключ для подписи JWT токенов (сгенерируйте надёжный секрет)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Сколько живёт сессия. По умолчанию 7 суток: 12 часов не хватало — менеджеры
# теряли сессию посреди рабочего дня. Формат: часы (12) или 30m, 12h, 7d.
# Пока человек работает в CRM, сессия продлевается сама.
# SESSION_TTL=7d

# Через сколько продлевать токен (по умолчанию — половина срока).
# SESSION_RENEW_AFTER=12h

# Порт приложения
PORT=3000

# Окружение (development / production)
NODE_ENV=production

# --- Docker Compose ---
# Пароль PostgreSQL (обязателен для docker-compose)
POSTGRES_PASSWORD=change_me_strong_password

# Cookie передаётся только по HTTPS (включайте после настройки SSL)
COOKIE_SECURE=false

# Приложение за nginx/прокси — нужно для корректных IP в лимитах
TRUST_PROXY=true

# Дополнительные разрешённые Origin через запятую (обычно не нужны)
CORS_ORIGINS=
