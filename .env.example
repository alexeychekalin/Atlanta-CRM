# =============================================
# Переменные окружения CRM «Атланта»
# Скопируйте этот файл в server/.env и укажите ваши параметры
# =============================================

# Подключение к PostgreSQL
DATABASE_URL=postgresql://atlanta_user:atlanta_pass@localhost:5432/atlanta_crm

# Секретный ключ для подписи JWT токенов (сгенерируйте надёжный секрет)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Порт приложения
PORT=3000

# Окружение (development / production)
NODE_ENV=production
